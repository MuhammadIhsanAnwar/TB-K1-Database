parameters:
    level: 5
    paths:
        - app
        - config
        - routes
    
    # Filament package analysis settings - suppress vendor autoload issues
    ignoreErrors:
        # Filament Forms Components (IDE caching - vendor classes not fully indexed)
        -
            message: '(Undefined type|Use of unknown class).*Filament\\Forms\\Components'
            path: 'app/Filament/Admin/Resources/*'
        
        # Filament Tables Actions (IDE caching - vendor classes not fully indexed)
        -
            message: '(Undefined type|Use of unknown class).*Filament\\Tables\\Actions'
            path: 'app/Filament/Admin/Resources/*'
        
        # Filament Schemas (IDE caching)
        -
            message: '(Undefined type|Use of unknown class).*Filament\\Schemas'
            path: 'app/Filament/Admin/Resources/*'
        
        # Filament Pages components
        -
            message: '(Undefined type|Use of unknown class).*Filament\\Pages'
            path: 'app/Filament/Admin/Pages/*'
        
        # Widget classes
        -
            message: '(Undefined type|Use of unknown class).*Filament.*Widget'
            path: 'app/Filament/Admin/Widgets/*'
